[Unit]
Description=SIGNAL Tech Intelligence Digest (Streamlit)
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=dp
WorkingDirectory=/home/dp/projects/signal
Environment="PATH=/home/dp/projects/signal/venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/dp/projects/signal/venv/bin/streamlit run app.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
