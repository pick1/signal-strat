dist/
build/

# Data files
data/*.json
!data/.gitkeep

# Streamlit
.streamlit/secrets.toml

# Environment
.env
.envrc

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
